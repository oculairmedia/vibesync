{
  "name": "vibesync",
  "version": "1.0.0",
  "description": "Beads-backed molecule orchestration engine with a small project registry",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "vibesync": "src/app/cli.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun run build:openapi && bun build --target=bun --outdir=dist src/index.ts src/app/cli.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "build:cli": "bun build --target=bun --outfile dist/vibesync-cli.js src/app/cli.ts",
    "test": "bun run build:openapi && bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage",
    "test:unit": "bunx vitest run tests/unit",
    "test:integration": "bunx vitest run tests/integration",
    "lint": "node scripts/eslint-baseline-check.mjs",
    "lint:fix": "eslint . --fix",
    "lint:raw": "eslint .",
    "lint:baseline:update": "node scripts/eslint-baseline-update.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "bunx tsc -p tsconfig.json --noEmit",
    "type-check:all": "bun run type-check",
    "vibesync": "bun src/app/cli.ts",
    "build:openapi": "bun scripts/generate-openapi.ts",
    "rig:dogfood": "bun scripts/dogfood-rig.ts"
  },
  "keywords": [
    "vibesync",
    "pm-agents",
    "sync",
    "mcp",
    "bidirectional-sync"
  ],
  "author": "Oculair Media",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@number0/iroh": "1.2.0",
    "better-sqlite3": "^12.4.6",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dotenv": "^17.2.3",
    "mysql2": "^3.20.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "smol-toml": "^1.6.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "engines": {
    "bun": ">=1.2.10",
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^4.0.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.6"
  }
}
