# SQLite databases
*.db
*.db?*
*.db-journal
*.db-wal
*.db-shm

# Daemon runtime files
daemon.lock
daemon.log
daemon.pid
bd.sock
dolt-server.lock
dolt-server.pid
dolt-server.port
last-touched

# Local version tracking (prevents upgrade notification spam after git ops)
.local_version

# Legacy database files
db.sqlite
bd.db

# Dolt server data directory (runtime state)
dolt/

# Merge artifacts (temporary files from 3-way merge)
beads.base.jsonl
beads.base.meta.json
beads.left.jsonl
beads.left.meta.json
beads.right.jsonl
beads.right.meta.json

# Keep JSONL exports and config (source of truth for git)
!interactions.jsonl
!metadata.json
!config.json

# Dolt is the source of truth — these exports just churn in git
# (per vibesync-1rx: causes constant PR conflicts, no info not already in Dolt)
issues.jsonl
export-state.json

# Meridian tool audit log — runtime operational telemetry, not source
meridian-audit.jsonl
